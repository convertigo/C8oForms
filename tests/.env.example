# Copy this file to .env and fill in the values. .env is gitignored.

# Where the app runs. Pick ONE of the two:
#
# 1) Convertigo server (shared repro or a local studio). Set only the host;
#    the /convertigo/projects/C8Oforms/DisplayObjects/mobile/ path is appended.
#       shared repro server : https://test-repro.convertigo.net
#       local studio        : http://localhost:18080
C8OFORMS_BASE_URL=https://test-repro.convertigo.net
#
# 2) Dev server (ng serve), where the app is served at the root. Set the full
#    URL; it is used as-is and takes precedence over C8OFORMS_BASE_URL.
# C8OFORMS_APP_URL=http://localhost:41378/

# Test user used by the Playwright specs to log in to the app.
# Disposable yopmail account; the password equals the login.
C8OFORMS_TEST_USER=testuser-convertigo@yopmail.com
C8OFORMS_TEST_PASSWORD=testuser-convertigo@yopmail.com

# Optional second Studio account for functional cross-user scenarios. If omitted
# and CONVERTIGO_ADMIN_PASSWORD is set, functional specs auto-provision
# c8oforms-functional-secondary@yopmail.com through C8Oforms.AddUser.
# Password defaults to the login if omitted.
# C8OFORMS_FUNCTIONAL_SECONDARY_USER=
# C8OFORMS_FUNCTIONAL_SECONDARY_PASSWORD=
# Optional MCP bearer token for the second account. Required only by SRC-010
# Baserow source isolation, where both accounts need isolated Baserow fixtures.
# C8OFORMS_FUNCTIONAL_SECONDARY_MCP_TOKEN=

# Optional clean Studio account for isolated empty-dashboard scenarios. If
# omitted and CONVERTIGO_ADMIN_PASSWORD is set, functional specs auto-provision
# c8oforms-functional-empty@yopmail.com through C8Oforms.AddUser and clean its
# owned forms/responses before the isolated dashboard test.
# Password defaults to the login if omitted.
# C8OFORMS_FUNCTIONAL_EMPTY_USER=
# C8OFORMS_FUNCTIONAL_EMPTY_PASSWORD=

# Optional Studio account for Admin UI scenarios. If omitted and
# CONVERTIGO_ADMIN_PASSWORD is set, functional specs auto-provision
# c8oforms-functional-admin@yopmail.com and grant it the C8Oforms admin right.
# Password defaults to the login if omitted.
# C8OFORMS_FUNCTIONAL_ADMIN_USER=
# C8OFORMS_FUNCTIONAL_ADMIN_PASSWORD=
# Optional namespace for auto-provisioned functional accounts.
# C8OFORMS_FUNCTIONAL_USER_PREFIX=c8oforms-functional
# C8OFORMS_FUNCTIONAL_USER_DOMAIN=yopmail.com

# Note: every spec builds its own fixture through the UI, so there is no form id
# to configure — each test creates (and works on) a fresh form.

# Only needed by Baserow fixtures (e2e/helpers/baserow.ts → ensureBaserowTable):
# a No Code Studio MCP bearer token (forms:write). Leave empty unless a spec
# needs Baserow-backed data. The helper also accepts greg-forms-codex as a
# local fallback key. C8OFORMS_MCP_URL defaults to <base>/convertigo/api/mcp.
# C8OFORMS_MCP_TOKEN=
# greg-forms-codex=
# C8OFORMS_MCP_URL=

# Admin password for the Convertigo server (user is always admin unless
# CONVERTIGO_ADMIN_USER is set). Used by verify.mjs and by functional specs that
# auto-provision users through C8Oforms.AddUser.
CONVERTIGO_ADMIN_PASSWORD=
# CONVERTIGO_ADMIN_USER=admin

# --- Only needed for verify.mjs (deploying versions to the repro server) ---
# Deploy server, if different from C8OFORMS_BASE_URL's host.
# C8O_SERVER=https://test-repro.convertigo.net
# C8O_REPO=convertigo/C8oForms
# "latest" picks the newest release of the highest version line (so a 2.1.x
# hotfix released after the 2.2 betas is ignored). Pin a line explicitly here:
# C8O_RELEASE_PREFIX=2.2.0-beta
